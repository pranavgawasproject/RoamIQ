# Supabase Config (Next.js requires the NEXT_PUBLIC_ prefix for client bundling)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Fallbacks (for server-side render environments)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only admin password for /admin (never use NEXT_PUBLIC_ prefix)
ADMIN_PASSWORD=your-strong-admin-password-here
