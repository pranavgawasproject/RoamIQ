# Supabase Config (Next.js requires the NEXT_PUBLIC_ prefix for client bundling)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Fallbacks (for server-side render environments)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Admin panel access (server-only — never use NEXT_PUBLIC_ for this)
# Set the same value in Vercel Project Settings → Environment Variables
ADMIN_ACCESS_KEY=your-strong-admin-key-here
